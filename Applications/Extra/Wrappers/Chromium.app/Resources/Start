# Start Chromium with the user's normal profile (~/.config/chromium).
# --class: the wrapper (WrappedAppClassName in GSWrapper.plist) tracks the
# windows of this class, shows its menu for them and appears as running in
# the Dock; WMWindowAttributes gives the class no appicon of its own.
CLASS="Wrapper_Chromium"
CHROME=`type -p chromium`
[ -z "$CHROME" ] && CHROME=`type -p google-chrome`
[ -z "$CHROME" ] && CHROME=`type -p chromium-browser`
[ -z "$CHROME" ] && CHROME=`type -p chrome`

if [ -z "$CHROME" ];then
  echo "no chromium|google-chrome|chromium-browser|chrome found!"
  exit 10
fi

unset FONTCONFIG_FILE

if [ -n "$FILE" ];then
  "$CHROME" --class="$CLASS" "$FILE"
else
  "$CHROME" --class="$CLASS"
fi
