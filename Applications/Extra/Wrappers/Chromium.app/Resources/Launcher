# Menu actions of Chromium.app's wrapper menu (Launcher.gorm, ShellUIProxy):
# $1 = action, $2 = X window id (hex, without 0x) for window actions.
CLASS="Wrapper_Chromium"

key() {  # send a key to the browser window $2 (or its last active one)
  w="${2:+0x$2}"
  [ -z "$w" ] && w=$(xdotool search --onlyvisible --class "$CLASS" | tail -1)
  [ -n "$w" ] && xdotool windowactivate --sync "$w" key --clearmodifiers "$1"
}

case "$1" in
  donewpage)        chromium --class="$CLASS" --new-window ;;
  donewtab)         key ctrl+t ;;
  dowindowminimize) xdotool windowminimize "0x$2" ;;
  dowindowactivate) xdotool windowactivate "0x$2" ;;
  dowindowclose)    xdotool windowclose "0x$2" ;;
  docut)            key ctrl+x "$2" ;;
  docopy)           key ctrl+c "$2" ;;
  dopaste)          key ctrl+v "$2" ;;
  doselectall)      key ctrl+a "$2" ;;
esac
