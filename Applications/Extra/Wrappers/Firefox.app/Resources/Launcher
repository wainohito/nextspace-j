case "$1" in
  donewpage)
    firefox --new-window
    ;;
  donewtab)
    firefox --new-tab --url about:newtab
    ;;
  dowindowminimize)
    xdotool windowminimize "0x$2"
    ;;
  dowindowactivate)
    xdotool windowactivate "0x$2"
    ;;
  dowindowclose)
    xdotool windowclose "0x$2"
    ;;
  doselectall)
    xdotool key "ctrl+a" "0x$2"
    ;;
esac
