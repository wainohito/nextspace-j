// Install as /etc/apt/apt.conf.d/99nextspace-fonts
// After apt installs or removes packages (e.g. fonts-*), refresh the .nfont
// packages NEXTSPACE uses (~/Library/Fonts/* (auto).nfont) for every user
// with a NEXTSPACE home.  See nextspace-fonts (/usr/local/bin with install.sh,
// /usr/NextSpace/bin with the packages).
DPkg::Post-Invoke { "for f in /usr/NextSpace/bin/nextspace-fonts /usr/local/bin/nextspace-fonts; do if [ -x $f ]; then $f --all-users; break; fi; done; true"; };
