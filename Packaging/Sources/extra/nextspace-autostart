#!/bin/sh
# Started by Login (SessionScript, ~/Library/Preferences/.NextSpace/Login or
# Login.app's default Login.user) before Workspace.  Helper scripts are
# looked up next to this one (~/.local/bin with install.sh,
# /usr/NextSpace/bin with the packages).
here=$(cd "$(dirname "$0")" && pwd)
state="$HOME/.local/state/nextspace"

# First login with the packages: the user's NEXTSPACE-J settings
if [ ! -e "$state/user-setup-done" ] && [ -x "$here/nextspace-user-setup" ]; then
  "$here/nextspace-user-setup" >/dev/null 2>&1
fi

# Fonts installed since the last login (apt, ~/.local/share/fonts): make
# them available to NEXTSPACE before Workspace and applications start.
fonts=$(command -v nextspace-fonts || echo "$here/nextspace-fonts")
[ -x "$fonts" ] && "$fonts" >/dev/null 2>&1

# Window manager settings (Dock, fonts, window attributes) requested while a
# session was running (the WM writes its state back at logout, so they can
# only be applied before Workspace starts): apply them once now.
pending="$state/wm-setup-pending"
if [ -e "$pending" ] && [ -x "$here/nextspace-wm-setup" ]; then
  "$here/nextspace-wm-setup" >/dev/null 2>&1 && rm -f "$pending"
fi

(
  # First login only: a fresh system starts with the sound card muted, and
  # PulseAudio keeps that state.  Unmute the output and set a moderate
  # volume once; later changes by the user are left alone.
  marker="$HOME/.local/state/nextspace/sound-initialized"
  if [ ! -e "$marker" ] && command -v pactl >/dev/null; then
    i=0
    until pactl info >/dev/null 2>&1 || [ $i -ge 20 ]; do
      sleep 1; i=$((i + 1))
    done
    if pactl set-sink-mute @DEFAULT_SINK@ 0 && pactl set-sink-volume @DEFAULT_SINK@ 50%; then
      mkdir -p "$(dirname "$marker")" && touch "$marker"
    fi
  fi

  sleep 6
  pgrep -x wmsystemtray >/dev/null || wmsystemtray &
  sleep 1
  pgrep -x pasystray >/dev/null || pasystray &
) >/dev/null 2>&1 </dev/null &
exit 0
