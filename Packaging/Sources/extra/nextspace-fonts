#!/usr/bin/env python3
"""Make the fonts known to fontconfig available to NEXTSPACE.

NEXTSPACE's art backend only reads .nfont packages, not fontconfig.  This
generates one .nfont package per font family in ~/Library/Fonts for every
TrueType/OpenType font fontconfig lists (Debian packages, ~/.local/share/fonts,
...).  The packages point at the font files (and the face index for .ttc
collections, "file.ttc#N"); nothing is copied.

* Faces already provided by a .nfont package elsewhere (/Library/Fonts,
  /usr/NextSpace/Fonts, ...) are skipped; when a family is partly provided
  there, the other faces join that family.
* Generated packages are named "<Family> (auto).nfont" and contain the key
  NXFontsAutoGenerated; only those are updated or removed.
* Run at every login (nextspace-autostart) and after apt installs packages
  (/etc/apt/apt.conf.d/99nextspace-fonts).  Applications see new fonts when
  they start.

usage: nextspace-fonts [-v]          for the current user
       nextspace-fonts --all-users   as root: for every user (uid >= 1000)
                                     who has a NEXTSPACE home (~/Library)
"""
import os
import pwd
import re
import shutil
import subprocess
import sys

VERBOSE = "-v" in sys.argv
HOME = pwd.getpwuid(os.getuid()).pw_dir  # not $HOME: also run via runuser
OUT = os.path.join(HOME, "Library", "Fonts")
SYSTEM_DIRS = ["/Library/Fonts", "/Developer/Library/Fonts", "/usr/NextSpace/Fonts"]
SUFFIX = " (auto).nfont"
MARK = "NXFontsAutoGenerated"
FORMATS = {"TrueType", "CFF"}


def log(*a):
    if VERBOSE:
        print(*a)


def system_faces():
    """PostScript name -> family of the .nfont packages not made by us."""
    faces = {}
    dirs = [OUT] + SYSTEM_DIRS
    for d in dirs:
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for n in names:
            if not n.endswith(".nfont") or (d == OUT and n.endswith(SUFFIX)):
                continue
            try:
                text = open(os.path.join(d, n, "FontInfo.plist"), errors="replace").read()
            except OSError:
                continue
            if MARK in text:
                continue
            m = re.search(r'\bFamily\s*=\s*"?([^";]+)"?\s*;', text)
            family = m.group(1).strip() if m else n[:-len(".nfont")]
            for ps in re.findall(r'PostScriptName\s*=\s*"?([^";]+)"?\s*;', text):
                faces.setdefault(ps.strip(), family)
    return faces


def gs_weight(fc):
    """fontconfig weight -> NSFontManager weight (0-15, 5 = regular, 9 = bold)."""
    for limit, w in ((0, 1), (40, 2), (50, 3), (75, 4), (80, 5), (100, 6), (180, 8),
                     (200, 9), (205, 10), (210, 12)):
        if fc <= limit:
            return w
    return 13


def q(s):
    """OpenStep property list string, non-ASCII as \\U escapes."""
    s = s.replace("\\", "\\\\").replace('"', '\\"')
    return '"' + "".join(c if ord(c) < 128 else "\\U%04X" % ord(c) for c in s) + '"'


def main():
    fmt = ("%{family[0]}\t%{style[0]}\t%{postscriptname}\t%{weight}\t%{slant}\t"
           "%{spacing}\t%{fontformat}\t%{color}\t%{index}\t%{file}\n")
    try:
        out = subprocess.run(["fc-list", "--format", fmt], capture_output=True,
                             text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError) as e:
        print("nextspace-fonts: fc-list failed:", e, file=sys.stderr)
        return 1

    known = system_faces()
    families = {}
    seen = set()
    for line in sorted(out.splitlines()):
        f = line.split("\t")
        if len(f) != 10:
            continue
        family, style, ps, weight, slant, spacing, form, color, index, path = f
        if form not in FORMATS or color == "True" or not ps or not family:
            continue
        if ps in known:
            # Same family as an existing package: add the other faces to it.
            families.setdefault(family, {"name": known[ps], "faces": []})["name"] = known[ps]
            continue
        if ps in seen:
            continue
        seen.add(ps)
        try:
            w = int(float(weight or 80))
            s = int(float(slant or 0))
        except ValueError:
            w, s = 80, 0
        traits = 0
        if s >= 100:
            traits |= 1  # NSItalicFontMask
        if gs_weight(w) >= 9:
            traits |= 2  # NSBoldFontMask
        if spacing == "100":
            traits |= 0x400  # NSFixedPitchFontMask
        file = path if index in ("", "0") else "%s#%s" % (path, index)
        fam = families.setdefault(family, {"name": family, "faces": []})
        fam["faces"].append((style or "Regular", ps, file, gs_weight(w), traits))

    wanted = {}
    for family, fam in families.items():
        if not fam["faces"]:
            continue
        dirname = re.sub(r"[/\x00]", "_", family) + SUFFIX
        lines = ["{", "    %s = YES;" % MARK, "    Family = %s;" % q(fam["name"]),
                 "    Faces = ("]
        faces = []
        for style, ps, file, weight, traits in sorted(fam["faces"], key=lambda x: (x[3], x[4], x[1])):
            faces.append("        {\n            Name = %s;\n            PostScriptName = %s;\n"
                         "            Files = (%s);\n            Weight = %d;\n"
                         "            Traits = %d;\n        }" % (q(style), q(ps), q(file), weight, traits))
        lines.append(",\n".join(faces))
        lines += ["    );", "}", ""]
        wanted[dirname] = "\n".join(lines)

    os.makedirs(OUT, exist_ok=True)
    added = updated = removed = 0
    for n in os.listdir(OUT):
        if n.endswith(SUFFIX) and n not in wanted:
            p = os.path.join(OUT, n)
            try:
                if MARK in open(os.path.join(p, "FontInfo.plist"), errors="replace").read():
                    shutil.rmtree(p)
                    removed += 1
                    log("removed", n)
            except OSError:
                pass
    for n, text in wanted.items():
        p = os.path.join(OUT, n, "FontInfo.plist")
        try:
            old = open(p).read()
        except OSError:
            old = None
        if old == text:
            continue
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p + ".tmp", "w") as fh:
            fh.write(text)
        os.replace(p + ".tmp", p)
        if old is None:
            added += 1
        else:
            updated += 1
        log("added" if old is None else "updated", n)
    if VERBOSE or added or updated or removed:
        print("nextspace-fonts: %d families (%d added, %d updated, %d removed) in %s"
              % (len(wanted), added, updated, removed, OUT))
    return 0


def all_users():
    if os.getuid() != 0:
        print("nextspace-fonts: --all-users must be run as root", file=sys.stderr)
        return 1
    me = os.path.abspath(sys.argv[0])
    for u in pwd.getpwall():
        if u.pw_uid < 1000 or u.pw_uid >= 65534 or not os.path.isdir(os.path.join(u.pw_dir, "Library")):
            continue
        subprocess.run(["runuser", "-u", u.pw_name, "--", me], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(all_users() if "--all-users" in sys.argv else main())
